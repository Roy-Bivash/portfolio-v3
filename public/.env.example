# Copier ce fichier en ".env" et chmod 640 .env
# Clés de connexion (texte clair OU hash généré avec password_hash, voir README ci-dessous)
KEY1=changez_moi_cle_1
KEY2=changez_moi_cle_2

# Dépôt git à cloner (HTTPS avec token recommandé)
REPO_URL=https://utilisateur:TOKEN@github.com/organisation/depot.git
# Branche (optionnel, vide = branche par défaut)
REPO_BRANCH=
# Sous-dossier du dépôt à utiliser comme contenu de data (optionnel, vide = tout le dépôt)
REPO_SUBDIR=data

